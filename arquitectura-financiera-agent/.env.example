# Arquitectura Financiera — AI Agent
# Copia este archivo como .env y añade tus credenciales

ANTHROPIC_API_KEY=tu_api_key_aqui
PORT=3000

# ── Instagram Graph API (opcional) ─────────────────────────────────────────
# Necesitas una cuenta Business/Creator y una App en developers.facebook.com
# Permisos requeridos: instagram_basic · instagram_manage_comments · instagram_manage_insights
# El token tiene validez de 60 días — renuévalo en el Explorador de API Graph

IG_ACCESS_TOKEN=     # Token de acceso de larga duración
IG_USER_ID=          # Tu ID numérico de usuario de Instagram
